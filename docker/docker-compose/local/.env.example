# Hindsight local stack - LLM + embedding provider configuration.
# Copy to .env (same directory, gitignored); Docker Compose reads it both for
# variable interpolation in docker-compose.yaml and via env_file, so every
# provider/model/endpoint below reaches the API container without editing the
# compose file.
#
# Defaults reproduce the original Zhipu setup: chat via the Coding Plan
# endpoint, embeddings via the general OpenAI-compatible endpoint. LLM and
# embeddings keys are declared separately so the two can diverge freely.
#
# Dimension note: pgvector's HNSW index (the default backend) caps vectors at
# 2000 dims, so keep HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS <= 2000 there.
# For wider vectors switch to the pgvectorscale (DiskANN) backend built into
# this stack's database image.

# ---- Chat / LLM (default: Zhipu GLM via coding-plan endpoint) ----
HINDSIGHT_API_LLM_API_KEY=your-zhipu-api-key
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
HINDSIGHT_API_LLM_MODEL=glm-5.3-flash

# ---- Embeddings (default: Zhipu embedding-3) ----
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=your-zhipu-api-key
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=embedding-3
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024

# Reranker: rrf (default, built-in) | local | tei | cohere | ...
# HINDSIGHT_API_RERANKER_PROVIDER=rrf

# ---- Vector index backend ----
# pgvector (default, HNSW, <= 2000 dims) | pgvectorscale (DiskANN, wider dims)
# HINDSIGHT_API_VECTOR_EXTENSION=pgvector

# Database image with pgvector + pgvectorscale preinstalled. Compose pulls
# this published Docker Hub image by default; override only to pin another
# tag.
# HINDSIGHT_DB_IMAGE=youbuwei/hindsight-db-pgvectorscale:pg18-pgvs0.9.1

# ---- Example: 2048-dimension embeddings (requires full rebuild) ----
# Zhipu embedding-3 natively supports 2048. Since the database image ships
# pgvectorscale, switch the index to DiskANN and raise the dimension:
# HINDSIGHT_API_VECTOR_EXTENSION=pgvectorscale
# HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=2048
# Wipe the old volume and restart (all memory data is discarded):
#   docker compose -f docker/docker-compose/local/docker-compose.yaml down -v
#   docker compose -f docker/docker-compose/local/docker-compose.yaml up -d

# ---- Example: DeepSeek chat + SiliconFlow embeddings ----
# DeepSeek has no embedding API, so keep embeddings on another provider.
# HINDSIGHT_API_LLM_API_KEY=your-deepseek-api-key
# HINDSIGHT_API_LLM_PROVIDER=deepseek
# HINDSIGHT_API_LLM_BASE_URL=https://api.deepseek.com/v1
# HINDSIGHT_API_LLM_MODEL=deepseek-chat
# HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=your-siliconflow-api-key
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
# HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=BAAI/bge-m3
# HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024

# ---- Example: OpenAI chat + embeddings ----
# HINDSIGHT_API_LLM_API_KEY=sk-your-openai-api-key
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=https://api.openai.com/v1
# HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
# HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=sk-your-openai-api-key
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
# HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://api.openai.com/v1
# HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
# HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1536

# ---- Example: Anthropic chat + SiliconFlow embeddings ----
# HINDSIGHT_API_LLM_API_KEY=sk-ant-your-anthropic-api-key
# HINDSIGHT_API_LLM_PROVIDER=anthropic
# HINDSIGHT_API_LLM_MODEL=claude-haiku-4-5
# HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=your-siliconflow-api-key
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
# HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=BAAI/bge-m3
# HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024

# ---- Example: fully local via Ollama (chat + embeddings) ----
# Use host.docker.internal (not localhost) so the container reaches a server
# running on the host; compose maps the name on Linux automatically.
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
# HINDSIGHT_API_LLM_MODEL=qwen3:14b
# HINDSIGHT_API_LLM_API_KEY=ollama
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
# HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=ollama
# HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=qwen3-embedding:4b
# HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024
